#!/bin/bash
# claude-cli-tools
# Claude Code install, backup, and restore for Linux (and macOS).
#
# Backs up ~/.claude/ using rsync --link-dest incremental snapshots.
# Each hourly run creates a dated snapshot directory. Unchanged files are
# hardlinks to the previous snapshot — zero extra disk space. Snapshots
# land in $XDG_DATA_HOME/claude-snapshots (default ~/.local/share/claude-snapshots):
# a copy of the user's own session history is "user-specific data" in the XDG
# sense, and it must sit OUTSIDE every git checkout — until 2026-10-15 it lived in
# ~/development/claude/snapshots, inside the claude-ops checkout, where git walked
# its 138,758 ignored files on every status (claude-ops
# TODO/bug_claude_credentials-in-snapshots.md). CLAUDE_SNAPSHOTS overrides it; the
# ansible roles that schedule --backup set it so the scheduler and this script agree.
#
# Keep SNAPSHOT_EXCLUDES tight. "Zero extra disk space" is true of hardlinks but
# NOT of restic, whose index scales with path count — an unfiltered snapshot set
# OOM-killed the fileshare LXC nightly in July 2026. Adding a large subtree here
# costs backup capacity even when it costs no disk.
#
# Usage:
#   claude-cli-tools --install    [--no-auto-restore]   Install Claude + setup
#   claude-cli-tools --setup                            Remove retired hooks, install hourly backup job
#   claude-cli-tools --backup                           Trim old conversations, create snapshot
#   claude-cli-tools --restore    [snapshot-dir] [--force]  Restore snapshot → ~/.claude/
#   claude-cli-tools --status                           Show snapshot info, sync state
#   claude-cli-tools --help

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS="$(uname -s)"
SNAPSHOT_DIR_ROOT="${CLAUDE_SNAPSHOTS:-${XDG_DATA_HOME:-$HOME/.local/share}/claude-snapshots}"
CLAUDE_LIVE="$HOME/.claude"
# Tiered retention, replacing a flat MAX_SNAPSHOTS=336 (14 days × 24 hourly) on
# 2026-08-08. The flat count was the dominant cost in the whole backup estate:
# measured on the NFS share, claude/snapshots was 261,969 of 313,591 files — 84% —
# so restic's nightly walk was mostly re-indexing 336 rotations of one tree. Hourly
# for 48 h then daily gives ~62 snapshots for ~54,000 files, an ~80% cut, without
# losing the granularity that is actually used (rewinding a recent session).
#
# Two bands, not one number, because the value of a snapshot decays with age in a
# way a count cannot express: within two days you want the exact hour, beyond that
# you want the day. See ~/development/backup/TODO/bug_infra_fileshare-restic-oom.md
# task 1b.
SNAPSHOT_HOURLY_HOURS=48       # keep EVERY snapshot newer than this
SNAPSHOT_DAILY_DAYS=14         # beyond that, keep the newest one per day, this far back
MAX_LIVE_ARCHIVES=24           # pre-restore live-*.tar.gz tarballs (unrelated to the above)
# Conversation transcripts (~/.claude/projects/**/*.jsonl) are kept 90 days after
# their last change. Was 14 until 2026-10-08, when the operator approved 90 ("ok to
# 90"); Claude Code's own cleanupPeriodDays is set to 90 by ansible
# roles/tools/claude-code so the two deleters agree. Record:
# ~/development/claude/TODO/track_architecture_storage-budgets.md
CONVERSATION_HISTORY_DAYS=90

# Paths under ~/.claude/ excluded from every snapshot.
#
# file-history is Claude Code's rewind buffer — prior versions of files edited
# during a session. Excluding it does NOT disable rewind: ~/.claude/file-history
# stays live and untouched. It only stops archiving it hourly.
#
# Why it matters: it is ~5,100 of the ~6,000 files in a snapshot (85%). Across
# MAX_SNAPSHOTS that was ~893,000 paths on the NFS share. --link-dest hardlinks
# keep that cheap on disk, but restic's index scales with PATH COUNT, not bytes,
# and it OOM-killed the 1 GiB fileshare LXC nightly from 2026-07-25, taking /srv
# (including unreproducible sensor data) out of backup entirely.
# See ~/development/backup/TODO/bug_infra_fileshare-restic-oom.md
#
# What is lost: restoring an old snapshot won't rewind file edits from that old
# session. The files it shadows live in ~/development, which is in git and in
# restic, so git already answers "what did this look like before" for anything
# committed. Uncommitted mid-session state is the real gap — accepted knowingly.
#
# .credentials.json is the live Claude Code OAuth login (access + refresh token).
# Excluded since 2026-10-15 with the operator's approval: every hourly snapshot
# kept a copy of whatever token was live that hour (61 copies, 20 distinct, in the
# utility/fileshare tree on 2026-10-15), on an NFS share and in the restic repo
# that backs it. Restore does not need it: --restore is `rsync -a` with no
# --delete, so an excluded file leaves the live login untouched, and a fresh
# machine re-authenticates with `claude` itself.
# Record: ~/development/claude/TODO/bug_claude_credentials-in-snapshots.md
SNAPSHOT_EXCLUDES=(file-history .credentials.json)
FORCE=0
NO_AUTO_RESTORE=0
MODE=""
SNAPSHOT=""

# ── Helpers ───────────────────────────────────────────────────────────────────

usage() {
    cat <<'EOF'
claude-cli-tools — Claude Code install, backup, and restore for Linux

Usage:
  claude-cli-tools --install    [--no-auto-restore]
      Install Claude (native installer) and run --setup. If snapshots exist,
      auto-restores the latest one. Pass --no-auto-restore to skip.

  claude-cli-tools --setup
      Remove the retired bash audit hooks from ~/.claude/settings.json (if
      present) and install an hourly backup job (cron on Linux, launchd on macOS). Safe to re-run (idempotent).

  claude-cli-tools --backup
      Trim .jsonl sessions older than 90 days from ~/.claude/projects/,
      then create an incremental rsync snapshot under SNAPSHOT_DIR_ROOT.

  claude-cli-tools --restore [snapshot-dir] [--force]
      Restore the latest snapshot (or a named one) into ~/.claude/.
      Safety checks: source must be non-empty and >= 50% of dest size.
      --force overrides the size check (not the empty check).

  claude-cli-tools --status
      Show snapshot count, latest snapshot date, disk usage, and
      whether ~/.claude/ looks in sync with the latest snapshot.

  claude-cli-tools --help

Environment:
  CLAUDE_SNAPSHOTS   Override snapshot directory (default: ${XDG_DATA_HOME:-~/.local/share}/claude-snapshots)

Backup model (rsync --link-dest incremental):
  Each --backup creates SNAPSHOT_DIR_ROOT/snapshot-YYYYMMDDTHHMMSS/
  Unchanged files are hardlinks to the prior snapshot — zero extra space.
  Conversation history older than CONVERSATION_HISTORY_DAYS is trimmed from live
  before each snapshot. Snapshots rotate on a tiered policy: every snapshot for
  SNAPSHOT_HOURLY_HOURS, then one per day back to SNAPSHOT_DAILY_DAYS.
  --restore creates a live-YYYYMMDDTHHMMSS.tar.gz pre-restore safety snapshot.
EOF
}

file_size() { [ -f "$1" ] && stat -c '%s' "$1" 2>/dev/null || echo "0"; }
file_mtime() { [ -e "$1" ] && stat -c '%Y' "$1" 2>/dev/null || echo "0"; }
file_date()  { [ -e "$1" ] && stat -c '%y' "$1" 2>/dev/null | cut -c1-16 || echo "—"; }

# ── Conversation history trim ─────────────────────────────────────────────────

trim_old_conversations() {
    [ -d "$CLAUDE_LIVE/projects" ] || return
    local count
    count=$(find "$CLAUDE_LIVE/projects" -name "*.jsonl" -mtime "+$CONVERSATION_HISTORY_DAYS" \
        -print -delete 2>/dev/null | wc -l | tr -d ' ')
    [ "$count" -gt 0 ] && echo "  Trimmed $count conversation file(s) older than ${CONVERSATION_HISTORY_DAYS}d"
}

# ── Pre-restore safety snapshot ───────────────────────────────────────────────

snapshot_live_files() {
    [ -d "$CLAUDE_LIVE" ] || return
    local ts archive
    ts=$(date +%Y%m%dT%H%M%S)
    # Inside SNAPSHOT_DIR_ROOT, beside the snapshot-* directories: its parent is now
    # ~/.local/share, which belongs to every program, not to this one.
    archive="$SNAPSHOT_DIR_ROOT/live-${ts}.tar.gz"
    mkdir -p "$(dirname "$archive")"
    # Same credential exclusion as SNAPSHOT_EXCLUDES: restore never overwrites the
    # live login, so the pre-restore safety copy has no reason to hold it either.
    tar -czf "$archive" --exclude=.claude/.credentials.json -C "$HOME" .claude 2>/dev/null \
        && echo "  Pre-restore snapshot    → live-${ts}.tar.gz" \
        || echo "  WARNING: pre-restore snapshot failed"
}

# ── Incremental snapshot ──────────────────────────────────────────────────────

create_snapshot() {
    local ts prev snapshot_dir exclude_args=()
    prev=$(ls -td "$SNAPSHOT_DIR_ROOT"/snapshot-* 2>/dev/null | head -1)
    ts=$(date +%Y%m%dT%H%M%S)
    snapshot_dir="$SNAPSHOT_DIR_ROOT/snapshot-${ts}"
    mkdir -p "$snapshot_dir"

    local ex
    for ex in "${SNAPSHOT_EXCLUDES[@]}"; do
        exclude_args+=(--exclude="$ex")
    done

    if [ -n "$prev" ]; then
        rsync -a "${exclude_args[@]}" --link-dest="$prev" "$CLAUDE_LIVE/" "$snapshot_dir/" 2>/dev/null \
            && echo "  Snapshot (incremental)  → snapshot-${ts}" \
            || echo "  WARNING: incremental snapshot failed"
    else
        rsync -a "${exclude_args[@]}" "$CLAUDE_LIVE/" "$snapshot_dir/" 2>/dev/null \
            && echo "  Snapshot (full)         → snapshot-${ts}" \
            || echo "  WARNING: snapshot failed"
    fi
}

# ── Snapshot rotation ─────────────────────────────────────────────────────────

# Cutoff timestamp N hours ago, in the snapshot-name format (YYYYMMDDTHHMMSS).
# Snapshot names are lexicographically ordered by time, so a string compare against
# this is a valid age test — no per-directory stat, and no dependence on mtime, which
# --link-dest and NFS both perturb.
cutoff_stamp() {
    local hours_ago=$1
    if [ "$OS" = "Darwin" ]; then
        date -v-"${hours_ago}"H +%Y%m%dT%H%M%S
    else
        date -d "${hours_ago} hours ago" +%Y%m%dT%H%M%S
    fi
}

# Decide what to KEEP, then delete the rest — rather than computing what to delete.
# The inverse is what the flat `tail -n +337` did, and it cannot express "one per day":
# any count-based rule keeps whatever happens to be newest, so a burst of runs silently
# evicts older days. Selecting keepers makes the retention policy the thing in the code.
snapshots_to_keep() {
    local hourly_cutoff daily_cutoff name stamp day last_day=""
    hourly_cutoff="snapshot-$(cutoff_stamp "$SNAPSHOT_HOURLY_HOURS")"
    daily_cutoff="snapshot-$(cutoff_stamp $((SNAPSHOT_DAILY_DAYS * 24)))"

    # Newest first, so the first snapshot seen for a given day is that day's keeper.
    while read -r path; do
        [ -n "$path" ] || continue
        name=$(basename "$path")

        # Band 1 — inside the hourly window: keep everything.
        if [[ "$name" > "$hourly_cutoff" ]]; then
            echo "$path"
            continue
        fi

        # Past the daily window entirely: keep nothing older.
        [[ "$name" > "$daily_cutoff" ]] || continue

        # Band 2 — one per calendar day. stamp is YYYYMMDDTHHMMSS; day is the date part.
        stamp=${name#snapshot-}
        day=${stamp%%T*}
        if [ "$day" != "$last_day" ]; then
            echo "$path"
            last_day="$day"
        fi
    done < <(ls -1d "$SNAPSHOT_DIR_ROOT"/snapshot-* 2>/dev/null | sort -r)
}

rotate_snapshots() {
    local excess keep all n_keep n_del
    keep=$(snapshots_to_keep)

    # Refuse to act on an empty keep-set. If cutoff_stamp failed (an unexpected `date`),
    # every snapshot would fall outside both bands and this would delete the entire
    # history in one run. A backup rotation must fail closed.
    if [ -z "$keep" ]; then
        echo "  ⚠ Rotation skipped — computed an empty keep-set (refusing to delete everything)" >&2
    else
        all=$(ls -1d "$SNAPSHOT_DIR_ROOT"/snapshot-* 2>/dev/null)
        excess=$(comm -23 <(echo "$all" | sort) <(echo "$keep" | sort))
        if [ -n "$excess" ]; then
            n_keep=$(echo "$keep" | wc -l | tr -d ' ')
            n_del=$(echo "$excess" | wc -l | tr -d ' ')
            echo "$excess" | xargs rm -rf \
                && echo "  Rotated snapshots (kept $n_keep, removed $n_del — hourly ${SNAPSHOT_HOURLY_HOURS}h, then daily ${SNAPSHOT_DAILY_DAYS}d)"
        fi
    fi

    excess=$(ls -t "$SNAPSHOT_DIR_ROOT"/live-*.tar.gz 2>/dev/null | tail -n +$((MAX_LIVE_ARCHIVES + 1)))
    [ -n "$excess" ] && echo "$excess" | xargs rm -f \
        && echo "  Rotated old pre-restore snapshots"
}

# ── Safety check ──────────────────────────────────────────────────────────────

check_source_safe() {
    local src="$1" dest="$2" label="$3"
    local src_count dest_count pct

    if [ ! -d "$src" ]; then
        echo "ERROR: snapshot source not found: $src" >&2
        return 1
    fi

    src_count=$(find "$src" -type f | wc -l | tr -d ' ')
    if [ "$src_count" -eq 0 ]; then
        echo "ERROR: snapshot source is empty: $src" >&2
        return 1
    fi

    [ ! -d "$dest" ] && return 0

    dest_count=$(find "$dest" -type f | wc -l | tr -d ' ')
    [ "$dest_count" -eq 0 ] && return 0

    if [ "$src_count" -lt "$((dest_count / 2))" ]; then
        pct=$((src_count * 100 / dest_count))
        if [ "$FORCE" -eq 1 ]; then
            echo "  WARN  source has $src_count files (${pct}% of live $dest_count) (--force override)"
            return 0
        fi
        echo "ERROR: source has $src_count files (${pct}% of live $dest_count) — looks incomplete. Use --force to override." >&2
        return 1
    fi
    return 0
}

# ── --status ──────────────────────────────────────────────────────────────────

do_status() {
    local n_snapshots latest_snapshot snap_size snap_ts live_count snap_count
    n_snapshots=$(ls -d "$SNAPSHOT_DIR_ROOT"/snapshot-* 2>/dev/null | wc -l | tr -d ' ')
    latest_snapshot=$(ls -td "$SNAPSHOT_DIR_ROOT"/snapshot-* 2>/dev/null | head -1)
    snap_size=$(du -sh "$SNAPSHOT_DIR_ROOT" 2>/dev/null | cut -f1)
    live_count=$(find "$CLAUDE_LIVE" -type f 2>/dev/null | wc -l | tr -d ' ')

    echo ""
    echo "=== claude-cli-tools status ==="
    echo ""
    echo "  Live:        $CLAUDE_LIVE ($live_count files)"
    echo "  Snapshots:   $SNAPSHOT_DIR_ROOT"
    if [ -n "$latest_snapshot" ]; then
        snap_ts=$(basename "$latest_snapshot" | sed 's/snapshot-//')
        snap_count=$(find "$latest_snapshot" -type f 2>/dev/null | wc -l | tr -d ' ')
        echo "  Latest:      ${snap_ts:0:4}-${snap_ts:4:2}-${snap_ts:6:2} ${snap_ts:9:2}:${snap_ts:11:2}  ($snap_count files)"
        echo "  Count:       $n_snapshots snapshots  (hourly ${SNAPSHOT_HOURLY_HOURS}h, then daily ${SNAPSHOT_DAILY_DAYS}d)  ${snap_size:-?} total"

        if [ "$live_count" -gt 0 ] && [ "$snap_count" -lt "$((live_count / 2))" ]; then
            echo "  Sync:        BACKUP RECOMMENDED (snapshot ${snap_count} vs live ${live_count} files)"
        else
            echo "  Sync:        ✓ in sync"
        fi
    else
        echo "  Latest:      none yet — run --backup to create first snapshot"
    fi

    echo ""
    if [ "$OS" = "Darwin" ]; then
        if launchctl list "com.therain4u.claude-backup" &>/dev/null; then
            echo "  Launchd:     ✓ hourly backup active"
        else
            echo "  Launchd:     not loaded — run --setup to add"
        fi
    else
        local cron_line
        cron_line=$(crontab -l 2>/dev/null | grep "claude-cli-tools --backup")
        if [ -n "$cron_line" ]; then
            echo "  Cron:        ✓ hourly backup active"
        else
            echo "  Cron:        not installed — run --setup to add"
        fi
    fi

    if [ -f "$CLAUDE_LIVE/settings.json" ] && grep -q 'claude-cli-tools/hooks/' "$CLAUDE_LIVE/settings.json" 2>/dev/null; then
        echo "  Hooks:       ✗ retired audit hooks still in settings.json — run --setup to remove"
    fi

    echo ""
}

# ── --backup ──────────────────────────────────────────────────────────────────

do_backup() {
    echo ""
    echo "=== Backing up ~/.claude/ → incremental snapshot ==="
    echo ""
    mkdir -p "$SNAPSHOT_DIR_ROOT"
    trim_old_conversations
    create_snapshot
    rotate_snapshots
    echo ""
    echo "=== Backup complete ==="
    echo ""
}

# ── --restore ─────────────────────────────────────────────────────────────────

do_restore() {
    local snap_src
    snap_src="$SNAPSHOT"
    [ -z "$snap_src" ] && snap_src=$(ls -td "$SNAPSHOT_DIR_ROOT"/snapshot-* 2>/dev/null | head -1)

    if [ -z "$snap_src" ] || [ ! -d "$snap_src" ]; then
        echo "ERROR: No snapshots found in $SNAPSHOT_DIR_ROOT. Run --backup first." >&2
        exit 1
    fi

    echo ""
    echo "=== Restoring from $(basename "$snap_src") → ~/.claude/ ==="
    echo ""

    check_source_safe "$snap_src" "$CLAUDE_LIVE" "snapshot" || exit 1

    snapshot_live_files
    mkdir -p "$CLAUDE_LIVE"
    echo ""

    rsync -a "$snap_src/" "$CLAUDE_LIVE/" 2>/dev/null \
        && echo "  ✓  ~/.claude/ restored via rsync" \
        || { echo "ERROR: rsync restore failed" >&2; exit 1; }

    echo ""
    echo "=== Restore complete. Restart Claude Code if it's running. ==="
    echo ""
    rotate_snapshots
}

# ── --setup ───────────────────────────────────────────────────────────────────

do_setup() {
    echo ""
    echo "=== Setting up claude-cli-tools ==="
    echo ""

    # Snapshot directory
    mkdir -p "$SNAPSHOT_DIR_ROOT"
    echo "  ✓  Snapshot dir: $SNAPSHOT_DIR_ROOT"

    # Retired audit hooks. pre-bash.sh and post-bash.sh (bash command logging) were deleted
    # from this repo on 2026-08-28 (commits 8b4dc4e, 38adad8) because nothing they recorded
    # had a named use. Deleting the scripts did not delete the settings.json entries that
    # point at them, and once every checkout pulled the deletion (2026-10-08) every Bash
    # tool call in every session printed "hook error ... pre-bash.sh: not found". So
    # --setup now REMOVES any hook whose command points into this repo's hooks/ directory,
    # and touches nothing else: ansible owns other user-scope hooks (e.g. the SessionStart
    # dispatch), and the old merge here replaced data['hooks'] wholesale, which deleted them.
    # Ansible's claude-code role removes the same entries (claude_retired_hook_markers);
    # this copy covers a host set up by hand from this repo alone.
    local settings="$CLAUDE_LIVE/settings.json"
    if [ -f "$settings" ] && grep -q 'claude-cli-tools/hooks/' "$settings" 2>/dev/null; then
        if python3 - "$settings" <<'PYEOF'
import json, shutil, sys, time
path = sys.argv[1]
marker = 'claude-cli-tools/hooks/'
try:
    with open(path) as f:
        data = json.load(f)
except ValueError as e:
    sys.exit("  ERROR: %s is not valid JSON (%s); left untouched" % (path, e))
hooks = data.get('hooks')
if isinstance(hooks, dict):
    for event in list(hooks):
        groups = []
        for group in hooks[event]:
            kept = [h for h in group.get('hooks', []) if marker not in h.get('command', '')]
            if kept:
                group['hooks'] = kept
                groups.append(group)
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]
    if not hooks:
        del data['hooks']
shutil.copy2(path, '%s.bak-%s' % (path, time.strftime('%Y%m%dT%H%M%S')))
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
PYEOF
        then
            echo "  ✓  Removed retired audit hooks from settings.json (backup kept beside it)"
        fi
    else
        echo "  ✓  No retired audit hooks in settings.json"
    fi

    # Hourly backup job
    if [ "$OS" = "Darwin" ]; then
        local plist_label="com.therain4u.claude-backup"
        local plist_dir="$HOME/Library/LaunchAgents"
        local plist_path="$plist_dir/${plist_label}.plist"
        mkdir -p "$plist_dir"
        cat > "$plist_path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${plist_label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${SCRIPT_DIR}/claude-cli-tools</string>
        <string>--backup</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/claude-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-backup.log</string>
</dict>
</plist>
EOF
        if launchctl list "$plist_label" &>/dev/null; then
            launchctl unload "$plist_path" 2>/dev/null
            launchctl load "$plist_path"
            echo "  ✓  Hourly backup launchd agent reloaded"
        else
            launchctl load "$plist_path"
            echo "  ✓  Hourly backup launchd agent installed"
        fi
    else
        local cron_entry="0 * * * * $SCRIPT_DIR/claude-cli-tools --backup"
        if crontab -l 2>/dev/null | grep -q "claude-cli-tools --backup"; then
            echo "  ✓  Hourly backup cron already installed"
        else
            (crontab -l 2>/dev/null | grep -v "claude-cli-tools --backup"; echo "$cron_entry") | crontab -
            echo "  ✓  Hourly backup cron installed"
        fi
    fi

    echo ""
    echo "=== Setup complete ==="
    echo ""
}

# ── --install ─────────────────────────────────────────────────────────────────

do_install() {
    echo ""
    echo "=== Installing Claude Code ==="
    echo ""

    # Native installer
    echo "  Running Claude native installer..."
    curl -fsSL https://claude.ai/install.sh | bash
    echo ""
    # Ensure ~/.local/bin is in PATH
    if ! echo "$PATH" | grep -q "$HOME/.local/bin"; then
        local rc_file=".bashrc"
        [ "$OS" = "Darwin" ] && rc_file=".zshrc"
        echo "  NOTE: Add ~/.local/bin to your PATH (it's not there now)."
        echo "        Add to ~/${rc_file}:  export PATH=\"\$HOME/.local/bin:\$PATH\""
    fi

    echo ""
    do_setup

    # Auto-restore if snapshots exist
    local latest_snap
    latest_snap=$(ls -td "$SNAPSHOT_DIR_ROOT"/snapshot-* 2>/dev/null | head -1)
    if [ -n "$latest_snap" ]; then
        if [ "$NO_AUTO_RESTORE" -eq 1 ]; then
            echo "  Snapshots found but --no-auto-restore set — skipping restore."
            echo "  Run --restore when ready."
            echo ""
        else
            local snap_ts
            snap_ts=$(basename "$latest_snap" | sed 's/snapshot-//')
            echo "  Snapshots found (latest: ${snap_ts:0:4}-${snap_ts:4:2}-${snap_ts:6:2} ${snap_ts:9:2}:${snap_ts:11:2})"
            echo "  Auto-restoring to avoid backup cron capturing empty install..."
            echo ""
            do_restore
        fi
    else
        echo "  No snapshots found — new installation."
        echo "  Configure Claude, then run --backup to create your first snapshot."
        echo ""
    fi

    echo "=== Install complete ==="
    echo ""
}

# ── Main ──────────────────────────────────────────────────────────────────────

for arg in "$@"; do
    case "$arg" in
        --install)         MODE="install"   ;;
        --setup)           MODE="setup"     ;;
        --backup)          MODE="backup"    ;;
        --restore)         MODE="restore"   ;;
        --status)          MODE="status"    ;;
        --no-auto-restore) NO_AUTO_RESTORE=1 ;;
        --force)           FORCE=1          ;;
        --help|-h)         usage; exit 0    ;;
        --*)               echo "Unknown argument: $arg"; echo ""; usage; exit 1 ;;
        *)
            if [ -d "$arg" ]; then
                SNAPSHOT="$arg"
            else
                echo "Unknown argument: $arg"; echo ""; usage; exit 1
            fi
            ;;
    esac
done

if [ -z "$MODE" ]; then
    usage
    exit 1
fi

case "$MODE" in
    install) do_install ;;
    setup)   do_setup   ;;
    backup)  do_backup  ;;
