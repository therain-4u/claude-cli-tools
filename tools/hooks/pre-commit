# --- shared: refuse a commit on the trunk of a REPLICATED checkout (see the tool's docstring) ---
# ⛔ THIS BLOCK REFUSES WHEN THE GUARD IS MISSING, and that is the whole point of its shape. It
# used to be `if [ -x <one absolute path> ]; then ... fi`, so the day the guard moved the test
# simply came out false and every commit here went through UNGUARDED — no error, no warning,
# nothing in the output. A control that can vanish silently is not a control.
# claude-ops TODO/design_architecture_a-subsystem-owns-its-code-and-its-docs.md, step 3.
#
# Two homes are accepted for one release: the guard moved to claude-ops on 2026-09-03 to sit with
# the docs that explain it, and a repo whose hook has not been updated yet must not break.
_guard=""
for _c in "$HOME/development/claude/git-workflow/tools/guard-shared-trunk" \
          "$HOME/development/.claude/tools/guard-shared-trunk"; do
    [ -x "$_c" ] && { _guard="$_c"; break; }
done
if [ -z "$_guard" ]; then
    echo "pre-commit: guard-shared-trunk was not found — REFUSING rather than committing" >&2
    echo "  unguarded. It stands between a session's commit and a shared branch, so its" >&2
    echo "  absence is a reason to stop, not to continue quietly." >&2
    echo "  Looked in: ~/development/claude/git-workflow/tools/ then ~/development/.claude/tools/" >&2
    echo "  If the workspace is genuinely not here (CI, a bare clone): git commit --no-verify" >&2
    exit 1
fi
"$_guard" || exit 1
